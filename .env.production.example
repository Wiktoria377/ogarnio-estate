# OGARNIO ESTATE: zmienne produkcyjne (Railway → usługa → Variables).
# Ten plik to tylko wzór. Prawdziwe wartości wpisuj wyłącznie w panelu
# hostingu, nigdy do repozytorium ani do czatu.

# ── Supabase (Project Settings → API / Database) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
# Klucz publiczny "anon" (bezpieczny w przeglądarce, chroniony przez RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz service_role: TAJNY, tylko serwer (kolejka zadań, usuwanie konta).
SUPABASE_SERVICE_ROLE_KEY=
# Połączenie do migracji: Database → Connect → "Session pooler" (port 5432).
# Migracje uruchamiają się same przy każdym starcie kontenera.
DATABASE_URL=postgresql://postgres.TWOJ-PROJEKT:HASLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Adres aplikacji ─────────────────────────────────────────────────────
# Publiczny adres z Railway (Settings → Networking) albo własna domena.
NEXT_PUBLIC_SITE_URL=https://twoja-aplikacja.up.railway.app

# ── AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_REVIEW_MODEL=claude-haiku-5-5
# Nigdy nie ustawiaj AI_TEST_PROVIDER=1 w produkcji (serwer i tak to odrzuca).
AI_TEST_PROVIDER=0

# ── Serwer ──────────────────────────────────────────────────────────────
NODE_ENV=production
STORAGE_DRIVER=supabase
JOB_WORKER=inline
JOB_WORKER_CONCURRENCY=2
# 32 bajty base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# min. 24 znaki: openssl rand -base64 32
APP_SIGNING_SECRET=

# ── Opcjonalne (można dodać później) ────────────────────────────────────
# E-mail zaproszeń do zespołu (bez SMTP aplikacja pokazuje link do skopiowania).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Płatności Stripe, Meta, LinkedIn: docs/DEPLOYMENT.md, sekcje 4–5.
# Licencja Remotion (firmy powyżej 3 osób): https://www.remotion.pro/license
REMOTION_LICENSE_KEY=
