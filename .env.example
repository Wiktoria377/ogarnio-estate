# ── Supabase (wymagane) ────────────────────────────────────────────────
# Project Settings → API w panelu Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Klucz service_role: TYLKO po stronie serwera (usuwanie konta, eksport danych).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Publiczny adres aplikacji (linki w e-mailach: potwierdzenie konta, reset hasła).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Przechowywanie plików ──────────────────────────────────────────────
# supabase = Supabase Storage (bucket "workspace-files", produkcja)
# local    = dysk serwera (.data/uploads), wyłącznie dev/testy/self-hosting na jednym serwerze
STORAGE_DRIVER=supabase
LOCAL_STORAGE_DIR=.data/uploads

# ── Model AI (wymagane do generowania treści) ─────────────────────────
ANTHROPIC_API_KEY=
# Model główny (generowanie i poprawki) oraz model kontroli jakości.
AI_MODEL=claude-opus-5-5
AI_REVIEW_MODEL=claude-haiku-5-5
# Limity nadużyć: maks. wywołań AI na użytkownika na minutę.
AI_USER_RATE_PER_MINUTE=8

# ── Kolejka zadań (kampanie, render wideo) ─────────────────────────────
# inline = worker działa w procesie serwera Next.js (wymaga SUPABASE_SERVICE_ROLE_KEY)
# off    = brak workera w tym procesie (np. osobny serwer renderujący)
JOB_WORKER=inline
JOB_WORKER_CONCURRENCY=2

# ── Video Studio (Remotion) ── WYMAGA KONFIGURACJI ─────────────────────
# Ścieżka do Chromium "headless shell" na serwerze renderującym.
# Pusta = Remotion pobierze przeglądarkę przy pierwszym renderze (wymaga internetu).
REMOTION_BROWSER_EXECUTABLE=
# Równoległość renderu klatek (domyślnie 2).
REMOTION_CONCURRENCY=
# Licencja firmowa Remotion (wymagana dla firm >3 osób): https://www.remotion.pro/license
REMOTION_LICENSE_KEY=

# ── Podgląd broszur PDF ────────────────────────────────────────────────
# Podgląd stron jako obrazy wymaga programu pdftoppm (pakiet poppler-utils).
# Bez niego edytor pokazuje PDF w przeglądarce (pobieranie działa zawsze).

# ── ETAP 3 ──────────────────────────────────────────────────────────────────
# Szyfrowanie tokenów OAuth (32 bajty base64): openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Podpisy linków (publiczne media dla platform, zaproszenia): min. 24 znaki
APP_SIGNING_SECRET=
# Stripe Billing (tryb testowy: sk_test_…, whsec_… z endpointu /api/billing/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# E-mail (zaproszenia). Bez SMTP aplikacja pokazuje link do skopiowania.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ogarnio Estate <no-reply@twojadomena.pl>"
# Meta (Facebook Login for Business): https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_OAUTH_PKCE=0
# LinkedIn: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# 1 = prosić o uprawnienia stron firmowych (wymaga zatwierdzonego Community Management API)
LINKEDIN_ORG_SCOPES=0
# Publiczny adres, z którego Meta pobiera media (domyślnie NEXT_PUBLIC_SITE_URL; musi być dostępny z internetu)
PUBLIC_MEDIA_BASE_URL=
# Tylko testy: symulator API platform (tests/mocks/social-api.mjs). Ignorowany w produkcji.
SOCIAL_API_MOCK=0

# ── ETAP 3, import ofert z CRM ──────────────────────────────────────────────
# Opcjonalnie: inny adres API (domyślnie oficjalne: https://api.asari.pro/site/, https://app.esticrm.pl/apiClient/)
ASARI_API_BASE=
ESTICRM_API_BASE=
# Odstęp między zapytaniami ASARI (limit 25/min); domyślnie 2600 ms
ASARI_MIN_INTERVAL_MS=
# Szablon adresu zdjęcia ASARI z identyfikatora, np. https://<serwer-zdjęć>/{id} (do potwierdzenia z ASARI)
ASARI_PHOTO_URL_TEMPLATE=
# TYLKO testy (ignorowane w produkcji): hosty dopuszczone mimo ochrony SSRF, np. 127.0.0.1:4020,127.0.0.1:4030 (symulator CRM i strona testowa analizy marki)
SAFE_FETCH_ALLOW_HOSTS=

# ── ETAP 3, analityka, panel administratora, strona sprzedażowa ─────────────
# Waluta stawek kosztów i budżetów bezpieczeństwa w panelu /admin
COST_CURRENCY=USD
# Adres zespołu, na który przychodzi powiadomienie o wiadomości z formularza kontaktowego (bez treści)
CONTACT_EMAIL=
# Cron bez inline workera: POST /api/jobs/tick z nagłówkiem Authorization: Bearer <JOB_TICK_SECRET>
JOB_TICK_SECRET=
